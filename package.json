{
  "name": "prompt-tester",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n srv,web -c blue,green \"node server/index.mjs\" \"vite client\"",
    "build": "tsc -p client && vite build client",
    "typecheck": "tsc -p client",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
